## Delivers an event frame to its handlers. False for a reply, an unknown type,
## or a type nobody subscribed to -- the host's unhandled-frame path.
func dispatch(frame: Dictionary) -> bool:
	if frame.has("success"):
		return false
	var handlers: Array = _handlers.get(String(frame.get("type", "")), [])
	if handlers.is_empty():
		return false
	for handler: Callable in handlers.duplicate():
		handler.call(frame.get("payload"), frame)
	return true
